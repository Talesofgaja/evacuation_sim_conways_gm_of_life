<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.evacsim.controller.SimulationController"
            stylesheets="@styles.css">

    <top>
        <VBox>
            <MenuBar>
                <Menu text="File">
                    <MenuItem text="Logout" onAction="#onLogout"/>
                    <MenuItem text="Exit" onAction="#onExit"/>
                </Menu>
                <Menu text="Help">
                    <MenuItem text="Assignment topics" onAction="#onHelp"/>
                </Menu>
            </MenuBar>
            <ToolBar>
                <Label fx:id="titleLabel" text="Crowd Evacuation Simulator" styleClass="title-label"/>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="playButton" text="Play" onAction="#onPlay"/>
                <Button fx:id="pauseButton" text="Pause" onAction="#onPause"/>
                <Button fx:id="stepButton" text="Step" onAction="#onStep"/>
                <Button fx:id="resetButton" text="Reset" onAction="#onReset"/>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <SplitPane fx:id="splitPane" dividerPositions="0.62">
            <StackPane fx:id="canvasHolder" minWidth="280" minHeight="300" styleClass="canvas-wrapper">
                <Canvas fx:id="simulationCanvas"/>
            </StackPane>

            <TabPane fx:id="sideTabs" tabClosingPolicy="UNAVAILABLE" minWidth="260" prefWidth="300">
                <Tab text="Run">
                    <ScrollPane fitToWidth="true">
                        <VBox spacing="8" styleClass="side-panel">
                            <padding>
                                <Insets top="10" right="12" bottom="10" left="12"/>
                            </padding>

                            <Label fx:id="subtitleLabel" text="Classroom cellular automaton"
                                   styleClass="subtitle-label" wrapText="true"/>

                            <TitledPane text="Scenario" expanded="true">
                                <VBox spacing="6">
                                    <Label fx:id="studentCountValueLabel" text="Students: 70"/>
                                    <Slider fx:id="studentCountSlider" min="60" max="80" value="70"
                                            showTickLabels="true" majorTickUnit="10" blockIncrement="1"/>

                                    <Label fx:id="shyPercentValueLabel" text="Shy: 70%  ·  Angry: 30%"/>
                                    <Slider fx:id="shyPercentSlider" min="0" max="100" value="70"
                                            showTickLabels="true" majorTickUnit="25" blockIncrement="5"/>

                                    <Label text="Speed (gens / sec)"/>
                                    <Slider fx:id="speedSlider" min="1" max="20" value="8"
                                            showTickLabels="true" majorTickUnit="5" blockIncrement="1"/>

                                    <Button fx:id="generateButton" text="Randomize Scenario"
                                            onAction="#onGenerateScenario"
                                            maxWidth="Infinity" styleClass="accent-button"/>
                                </VBox>
                            </TitledPane>

                            <TitledPane text="Live stats" expanded="true">
                                <VBox spacing="4">
                                    <Label fx:id="generationLabel" text="Generation: 0"/>
                                    <Label fx:id="remainingLabel" text="Students Remaining: 0"/>
                                    <Label fx:id="evacuatedLabel" text="Evacuated: 0 / 0"/>
                                    <Label fx:id="stunnedLabel" text="Stunned: 0"/>
                                    <Label fx:id="collisionsLabel" text="Collisions: 0"/>
                                    <Label fx:id="exitStatusLabel" text="Exits: —" wrapText="true"/>
                                    <Label fx:id="evacTimeLabel" text="Evacuation Time: —"/>
                                    <Label fx:id="hazardStatusLabel" text="Hazard: Clear" wrapText="true"/>
                                </VBox>
                            </TitledPane>

                            <Label text="Legend" styleClass="section-label"/>
                            <FlowPane hgap="10" vgap="4">
                                <Label text="Blue shy" styleClass="legend-label"/>
                                <Label text="Orange angry" styleClass="legend-label"/>
                                <Label text="Purple stunned" styleClass="legend-label"/>
                                <Label text="E1 / E2 / E3 exits" styleClass="legend-label"/>
                            </FlowPane>
                        </VBox>
                    </ScrollPane>
                </Tab>

                <Tab text="Archive">
                    <ScrollPane fitToWidth="true">
                        <VBox spacing="8" styleClass="side-panel">
                            <padding>
                                <Insets top="10" right="12" bottom="10" left="12"/>
                            </padding>
                            <Label text="SQLite scenarios (CRUD)" styleClass="section-label"/>
                            <TextField fx:id="scenarioNameField" promptText="Scenario name"/>
                            <TextField fx:id="scenarioNotesField" promptText="Notes"/>
                            <HBox spacing="6">
                                <Button text="Create" onAction="#onCreateScenario"/>
                                <Button text="Update" onAction="#onUpdateScenario"/>
                                <Button text="Delete" onAction="#onDeleteScenario"/>
                                <Button text="Load" onAction="#onLoadScenario"/>
                            </HBox>
                            <TableView fx:id="scenarioTable" prefHeight="140">
                                <columns>
                                    <TableColumn fx:id="colScenarioId" text="ID" prefWidth="36"/>
                                    <TableColumn fx:id="colScenarioName" text="Name" prefWidth="90"/>
                                    <TableColumn fx:id="colScenarioCount" text="N" prefWidth="40"/>
                                    <TableColumn fx:id="colScenarioShy" text="Shy%" prefWidth="50"/>
                                </columns>
                            </TableView>

                            <Label text="Saved runs" styleClass="section-label"/>
                            <Button text="Delete run" onAction="#onDeleteRun"/>
                            <TableView fx:id="runTable" prefHeight="130">
                                <columns>
                                    <TableColumn fx:id="colRunId" text="ID" prefWidth="36"/>
                                    <TableColumn fx:id="colRunGens" text="Gens" prefWidth="50"/>
                                    <TableColumn fx:id="colRunEvac" text="Out" prefWidth="40"/>
                                    <TableColumn fx:id="colRunHits" text="Hits" prefWidth="44"/>
                                </columns>
                            </TableView>
                            <Label fx:id="archiveStatusLabel" text="" styleClass="legend-label" wrapText="true"/>
                        </VBox>
                    </ScrollPane>
                </Tab>

                <Tab text="Weather">
                    <ScrollPane fitToWidth="true">
                        <VBox spacing="8" styleClass="side-panel">
                            <padding>
                                <Insets top="10" right="12" bottom="10" left="12"/>
                            </padding>
                            <Label text="HTTP JSON hazard feed" styleClass="section-label"/>
                            <ComboBox fx:id="cityCombo" prefWidth="Infinity"/>
                            <CheckBox fx:id="applyWeatherCheck" text="Apply weather to shy hesitation"
                                      selected="true"/>
                            <Button fx:id="fetchWeatherButton" text="Fetch Open-Meteo JSON"
                                    onAction="#onFetchWeather" maxWidth="Infinity" styleClass="accent-button"/>
                            <ProgressBar fx:id="weatherProgress" progress="-1" visible="false"
                                         maxWidth="Infinity"/>
                            <Label fx:id="weatherLabel" text="No fetch yet" wrapText="true"/>
                            <TextArea fx:id="jsonArea" prefRowCount="10" wrapText="true" editable="false"/>
                        </VBox>
                    </ScrollPane>
                </Tab>
            </TabPane>
        </SplitPane>
    </center>

    <bottom>
        <HBox spacing="12" styleClass="status-bar" alignment="CENTER_LEFT">
            <padding>
                <Insets top="4" right="10" bottom="4" left="10"/>
            </padding>
            <Label fx:id="operatorLabel" text="Operator: —"/>
            <Label fx:id="poolLabel" text="Pool: —"/>
            <Label fx:id="statusLabel" text="Ready" wrapText="true"/>
        </HBox>
    </bottom>
</BorderPane>
